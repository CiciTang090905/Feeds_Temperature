# Backend/server setup template only.
# End users do not need to configure this file.

PORT=3001
LABEL_POLL_INTERVAL_MS=10000

# Remote managed Postgres example:
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
#
# Local loopback Postgres example for hosted deployment:
DATABASE_URL=postgres://feeds_app:PASSWORD@127.0.0.1:5432/feeds_temperature

# Local dev: copy this to backend/.env.local
# Cloud/server: copy this to backend/.env
# Optional override: set ENV_FILE=/absolute/path/to/backend.env

LABEL_BATCH_ENABLED=0
LABEL_BATCH_PROVIDER=auto
LABEL_BATCH_SUBMITTER_INTERVAL_MS=600000
LABEL_BATCH_POLLER_INTERVAL_MS=60000
OPENAI_BATCH_MODEL=...
OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=...
AZURE_OPENAI_KEY=...
AZURE_OPENAI_DEPLOYMENT=...
AZURE_OPENAI_API_VERSION=2024-10-21
