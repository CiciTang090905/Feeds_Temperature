{
    "manifest_version": 3,
    "name": "Feeds_temperature",
    "version": "1.0.0",
    "description": "Capture visible X posts into local extension storage for feed analysis.",
    "permissions": [
        "storage"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "icons": {
        "16": "icon.png",
        "32": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://x.com/*",
                "https://twitter.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "options_page": "options.html",
    "host_permissions": [
        "http://localhost:3001/*",
        "https://x.com/*",
        "https://twitter.com/*"
    ]
}
